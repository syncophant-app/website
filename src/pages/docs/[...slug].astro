---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { sortDocs } from "../../data/docs";

export async function getStaticPaths() {
  const docs = sortDocs(await getCollection("docs"));
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[i - 1], next: docs[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
  prev?: CollectionEntry<"docs">;
  next?: CollectionEntry<"docs">;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<Docs title={entry.data.title} description={entry.data.description} current={entry.id}>
  <article class="doc canvas">
    <header class="doc__head">
      <p class="t-caption muted">{entry.data.section}</p>
      <h1 class="t-title">{entry.data.title}</h1>
      <p class="t-subheading muted">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (prev || next) && (
      <nav class="pager" aria-label="Previous and next">
        {prev ? (
          <a class="pager__link" href={`/docs/${prev.id}/`}>
            <span class="t-caption muted">Previous</span>
            <span class="t-label">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="pager__link pager__link--next" href={`/docs/${next.id}/`}>
            <span class="t-caption muted">Next</span>
            <span class="t-label">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Docs>

<style>
  .doc {
    padding: var(--space-2xl) clamp(20px, 5vw, 56px);
  }

  .doc__head {
    display: grid;
    gap: var(--space-md);
    max-width: 40em;
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
    border-bottom: 0.5px solid var(--line);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .pager__link {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-card);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--fill-2);
    transition: background-color var(--dur) var(--ease);
  }

  .pager__link:hover {
    background: var(--fill-1);
  }

  .pager__link--next {
    text-align: right;
  }

  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* Rendered Markdown. Global because Astro can't scope styles into <Content />. */
  .prose {
    max-width: 40em;
  }

  .prose > * + * {
    margin-top: var(--space-md);
  }

  .prose h2 {
    margin-top: var(--space-2xl);
    font-size: 24px;
    line-height: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .prose h3 {
    margin-top: var(--space-xl);
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .prose h2 + *,
  .prose h3 + * {
    margin-top: var(--space-sm);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li + li {
    margin-top: var(--space-xs);
  }

  .prose li::marker {
    color: var(--ink-muted);
  }

  .prose strong {
    font-weight: 600;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--fill-1);
  }

  .prose pre {
    overflow-x: auto;
    padding: 14px 16px;
    border-radius: var(--radius-tile);
    background: var(--mist);
    box-shadow: inset 0 0 0 0.5px var(--line);
  }

  .prose pre code {
    padding: 0;
    background: none;
    font-size: 13px;
    line-height: 20px;
  }

  .prose blockquote {
    padding: 12px 16px;
    border-radius: var(--radius-tile);
    background: var(--fill-1);
  }

  .prose blockquote > * + * {
    margin-top: var(--space-sm);
  }

  .prose table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 22px;
  }

  .prose th,
  .prose td {
    padding: 8px 14px 8px 0;
    border-bottom: 0.5px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    font-weight: 600;
  }

  .prose hr {
    border: 0;
    border-top: 0.5px solid var(--line);
    margin-block: var(--space-xl);
  }
</style>
