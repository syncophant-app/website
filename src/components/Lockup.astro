---
/**
 * Mark plus outlined Onest 650 wordmark. Paths are the design system's;
 * the wordmark's cap height is centred on the mark's ink (baseline 625 in
 * mark units), not pinned to the ears, so the word doesn't float above the
 * trunk. Gap 0.4 × cap height. Minimum height 20px.
 */
import { lockup } from "../data/brand";

interface Props {
  height?: number;
  class?: string;
}

const { height = 22, class: className } = Astro.props;
const geometry = lockup[height >= 48 ? "regular" : "small"];
const [, , w, h] = geometry.viewBox.split(" ").map(Number);
const width = Math.round((height * w) / h * 10) / 10;
---

<svg
  class={className}
  viewBox={geometry.viewBox}
  width={width}
  height={height}
  fill="currentColor"
  role="img"
  aria-label="Syncophant"
  focusable="false"
>
  <path d={geometry.mark}></path>
  <g transform={geometry.wordmarkTransform}><path d={geometry.wordmark}></path></g>
</svg>
