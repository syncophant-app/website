---
/**
 * A Finder window with remote storage added by Syncophant.
 * Illustration for the mockup; swap for a real screenshot before launch
 * (the design system shows the product only in real screenshots).
 */
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import FileIcon from "./FileIcon.astro";
import Status from "./Status.astro";
import type { FileState } from "../data/site";

type Row = {
  name: string;
  kind: "folder" | "document" | "movie" | "archive";
  size: string;
  state: FileState;
  progress?: number;
};

const rows: Row[] = [
  { name: "Invoices", kind: "folder", size: "--", state: "kept" },
  { name: "Photos 2026", kind: "folder", size: "--", state: "remote" },
  { name: "Kitchen renovation.mov", kind: "movie", size: "4.2 GB", state: "uploading", progress: 42 },
  { name: "Tax return 2025.pdf", kind: "document", size: "1.8 MB", state: "verifying" },
  { name: "Lease agreement.pdf", kind: "document", size: "640 KB", state: "verified" },
  { name: "Notes.md", kind: "document", size: "12 KB", state: "conflict" },
  { name: "Studio backup.zip", kind: "archive", size: "18.6 GB", state: "remote" },
];

const favorites = [
  { label: "Recents", icon: "recents" },
  { label: "Applications", icon: "applications" },
  { label: "Desktop", icon: "desktop" },
  { label: "Documents", icon: "documents" },
  { label: "Downloads", icon: "downloads" },
] as const;
---

<figure class="finder" aria-label="Finder showing remote storage added by Syncophant, with a status for every file">
  <aside class="finder__sidebar" aria-hidden="true">
    <div class="finder__lights"><i></i><i></i><i></i></div>
    <p class="finder__group">Favorites</p>
    <ul>
      {
        favorites.map((f) => (
          <li>
            <Icon name={f.icon} size={15} />
            {f.label}
          </li>
        ))
      }
    </ul>
    <p class="finder__group">Locations</p>
    <ul>
      <li><Icon name="drive" size={15} />Macintosh HD</li>
      <li class="is-selected">
        <Mark height={11} label="" />
        Home Server
        <Icon name="eject" size={13} class="finder__eject" />
      </li>
    </ul>
  </aside>

  <div class="finder__main">
    <div class="finder__toolbar" aria-hidden="true">
      <span class="finder__capsule">
        <Icon name="back" size={15} />
        <Icon name="forward" size={15} class="is-dim" />
      </span>
      <span class="finder__title">Documents</span>
      <span class="finder__spacer"></span>
      <span class="finder__capsule"><Icon name="list" size={15} /></span>
      <span class="finder__capsule finder__capsule--round"><Icon name="search" size={15} /></span>
    </div>

    <table class="finder__table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col" class="col-size">Size</th>
          <th scope="col" class="col-status">Status</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td class="col-name">
                <span class="finder__name">
                  <FileIcon kind={r.kind} size={17} />
                  <span>{r.name}</span>
                </span>
              </td>
              <td class="col-size">{r.size}</td>
              <td class="col-status">
                <Status state={r.state} />
                {r.progress !== undefined && (
                  <span class="finder__progress" aria-hidden="true">
                    <span style={`width:${r.progress}%`} />
                  </span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div class="finder__pathbar" aria-hidden="true">
      <Mark height={9} label="" />
      Home Server
      <span class="muted">›</span>
      <FileIcon kind="folder" size={12} />
      Documents
    </div>
  </div>
</figure>

<style>
  .finder {
    display: grid;
    grid-template-columns: 188px 1fr;
    gap: 0;
    padding: 8px;
    border-radius: 24px;
    background: var(--paper);
    box-shadow: var(--shadow-window);
    font-family: var(--font-system);
    text-align: left;
    color: var(--ink);
    overflow: hidden;
  }

  /* Sidebar: Tahoe's floating glass sidebar, inset from the window edge. */
  .finder__sidebar {
    border-radius: 17px;
    padding: 14px 10px 18px;
    background: var(--mist);
    box-shadow: inset 0 0 0 0.5px var(--fill-2);
  }

  .finder__lights {
    display: flex;
    gap: 8px;
    padding: 0 4px 16px;
  }
  .finder__lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--fill-2);
    box-shadow: inset 0 0 0 0.5px var(--fill-2);
  }

  .finder__group {
    padding: 10px 8px 4px;
    font-size: 11px;
    line-height: 14px;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .finder__sidebar li {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 8px;
    border-radius: var(--radius-row);
    font-size: 13px;
    line-height: 17px;
    color: var(--ink);
  }
  .finder__sidebar li :global(svg) {
    color: var(--ink-muted);
  }
  .finder__sidebar li.is-selected {
    background: var(--fill-2);
  }
  .finder__sidebar li.is-selected :global(svg) {
    color: var(--ink);
  }
  .finder__sidebar :global(.finder__eject) {
    margin-left: auto;
  }

  .finder__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .finder__toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 10px 0 16px;
  }
  .finder__capsule {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 10px;
    border-radius: var(--radius-capsule);
    background: var(--paper);
    box-shadow:
      0 0 0 0.5px var(--fill-2),
      0 2px 6px rgb(0 0 0 / 0.06);
    color: var(--ink);
  }
  .finder__capsule--round {
    width: 32px;
    padding: 0;
    justify-content: center;
  }
  .finder__capsule :global(.is-dim) {
    opacity: 0.35;
  }
  .finder__title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .finder__spacer {
    flex: 1;
  }

  .finder__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13px;
    line-height: 17px;
    padding: 0 8px;
  }
  .finder__table th {
    padding: 6px 10px 6px;
    font-size: 11px;
    line-height: 14px;
    font-weight: 500;
    color: var(--ink-muted);
    text-align: left;
    border-bottom: 0.5px solid var(--line);
    white-space: nowrap;
  }
  .finder__table td {
    height: 34px;
    padding: 0 10px;
    white-space: nowrap;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .finder__table tbody tr:nth-child(even) td {
    background: var(--fill-1);
  }
  .finder__table tbody tr:nth-child(even) td:first-child {
    border-radius: var(--radius-row) 0 0 var(--radius-row);
  }
  .finder__table tbody tr:nth-child(even) td:last-child {
    border-radius: 0 var(--radius-row) var(--radius-row) 0;
  }
  .finder__table .col-name {
    color: var(--ink);
  }
  .finder__table .col-size {
    text-align: right;
  }
  .finder__table th.col-size {
    width: 76px;
    text-align: right;
  }
  .finder__table th.col-status {
    width: 196px;
  }
  .finder__table td.col-status {
    overflow: hidden;
  }
  .finder__name {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .finder__name span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .col-status {
    position: relative;
  }
  .finder__progress {
    display: block;
    width: 120px;
    height: 3px;
    margin-top: 4px;
    border-radius: 2px;
    background: var(--fill-2);
    overflow: hidden;
  }
  .finder__progress span {
    display: block;
    height: 100%;
    background: var(--ink);
  }

  .finder__pathbar {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding: 18px 18px 8px;
    font-size: 11px;
    line-height: 14px;
    color: var(--ink-muted);
  }

  @media (max-width: 1180px) {
    .finder {
      grid-template-columns: 168px 1fr;
    }
  }

  @media (max-width: 900px) {
    .finder {
      grid-template-columns: 1fr;
    }
    .finder__sidebar {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .finder {
      padding: 4px;
      border-radius: 18px;
    }
    .col-size {
      display: none;
    }
    .finder__table th.col-status {
      width: 186px;
    }
    .finder__table {
      padding: 0 2px;
    }
    .finder__table td,
    .finder__table th {
      padding-inline: 8px;
    }
    .finder__progress {
      width: 80px;
    }
  }
</style>
