---
import Lockup from "./Lockup.astro";
import Mark from "./Mark.astro";
import { links } from "../data/site";
---

<footer class="footer">
  <div class="footer__inner wide">
    <Lockup height={20} />
    <nav aria-label="Footer">
      <ul class="footer__links t-small">
        <li><a href="/docs/">Docs</a></li>
        <li><a href={links.repo}>Source code</a></li>
        <li><a href={links.releases}>Releases</a></li>
        <li><a href={links.status}>Status</a></li>
        <li><a href={links.license}>License</a></li>
        <li><a href="/#privacy">Privacy</a></li>
      </ul>
    </nav>
    <p class="t-small muted">Free and open source. App GPL-3.0-or-later, libraries MIT.</p>
  </div>
  <div class="footer__mark" aria-hidden="true">
    <Mark height={420} label="" />
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-2xl);
    overflow: hidden;
  }

  .footer__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 22px;
  }

  .footer__links a {
    display: inline-block;
    padding-block: 4px;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* The mark, large and quiet, cropped by the bottom of the page. */
  .footer__mark {
    display: flex;
    justify-content: center;
    height: 240px;
    margin-top: var(--space-3xl);
    color: color-mix(in srgb, var(--ink) 6%, var(--mist));
  }

  .footer__mark :global(svg) {
    flex: none;
    max-width: none;
  }

  @media (max-width: 640px) {
    .footer__mark {
      height: 140px;
    }
    .footer__mark :global(svg) {
      width: 340px;
      height: auto;
    }
  }
</style>
