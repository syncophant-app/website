---
/** Monochrome stand-ins for Finder's folder and document icons. */
interface Props {
  kind: "folder" | "document" | "movie" | "archive";
  size?: number;
}
const { kind, size = 18 } = Astro.props;
---

{
  kind === "folder" ? (
    <svg class="fi fi--folder" viewBox="0 0 24 20" width={size} height={size * (20 / 24)} aria-hidden="true">
      <path d="M1.5 4.25C1.5 3.01 2.51 2 3.75 2h5.1c.6 0 1.17.24 1.59.66L11.75 4H20.25c1.24 0 2.25 1.01 2.25 2.25v.25H1.5z" class="fi__tab" />
      <rect x="1.5" y="5.5" width="21" height="13" rx="2.25" class="fi__body" />
    </svg>
  ) : (
    <svg class="fi fi--doc" viewBox="0 0 20 24" width={size * (20 / 24)} height={size} aria-hidden="true">
      <path d="M3.5 1.75h8.4l4.6 4.6v14.4c0 .83-.67 1.5-1.5 1.5H3.5c-.83 0-1.5-.67-1.5-1.5V3.25c0-.83.67-1.5 1.5-1.5Z" class="fi__page" />
      <path d="M11.75 1.9v3.35c0 .69.56 1.25 1.25 1.25h3.35" class="fi__fold" />
      {kind === "movie" && <path d="M8 11.5v5l4.25-2.5z" class="fi__mark" />}
      {kind === "archive" && <path d="M9.25 9h1.5M9.25 11.5h1.5M9.25 14h1.5M8.5 16.5h3v2.25h-3z" class="fi__zip" />}
    </svg>
  )
}

<style>
  .fi {
    flex: none;
  }
  .fi__tab {
    fill: var(--fill-3);
  }
  .fi__body {
    fill: var(--fill-2);
  }
  .fi__page {
    fill: var(--paper);
    stroke: var(--fill-3);
    stroke-width: 1;
  }
  .fi__fold {
    fill: none;
    stroke: var(--fill-3);
    stroke-width: 1;
  }
  .fi__mark {
    fill: var(--ink-muted);
  }
  .fi__zip {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 1;
  }
</style>
