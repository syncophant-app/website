---
const providers = [
  {
    name: "SFTP",
    body: "Any server you can reach over SSH, from a NAS to a VPS. Sign in with a password, a private key or your SSH agent. The server needs to run sha256sum, so uploads can be verified.",
  },
  {
    name: "WebDAV",
    body: "WebDAV servers over HTTPS. Syncophant reads the copy back to check each upload.",
  },
  {
    name: "S3-compatible storage",
    body: "Buckets on any S3-compatible service, over HTTPS. S3 can't rename in one step, so Syncophant copies instead, and the trash is off there.",
  },
  {
    name: "SMB",
    body: "Shares on a Mac, PC or NAS, as long as the share requires SMB3 encryption and signing.",
  },
  {
    name: "Dropbox, OneDrive and Box",
    body: "Sign in through your browser with an app you create in the service's developer console. Syncophant ships no app keys of its own and shows you the steps. Deleted files go to the service's trash.",
  },
  {
    name: "Google Drive (experimental)",
    body: "Signs in the same way. Google Drive can't refuse a stale write, so Syncophant checks in the app, and a change made elsewhere at the same moment can be lost or duplicated. Google Docs are skipped.",
  },
];
---

<section class="section" aria-labelledby="works-title">
  <div class="measure">
    <div class="section-head">
      <h2 id="works-title" class="t-title">Bring the storage you already have.</h2>
    </div>

    <dl class="providers">
      {
        providers.map((p) => (
          <div class="provider">
            <dt class="t-heading">{p.name}</dt>
            <dd class="muted">{p.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="t-small muted providers__later">
      Have a Hetzner Storage Box? Paste an API token and Syncophant sets up a sub-account that only reaches one folder.
    </p>
  </div>
</section>

<style>
  .providers {
    display: grid;
    gap: var(--space-xl);
  }

  .provider {
    display: grid;
    gap: var(--space-sm);
  }

  .providers__later {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 0.5px solid var(--line);
  }
</style>
