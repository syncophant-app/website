---
/**
 * Six small pieces of the product, each drawn as the UI fragment it is,
 * with a two-line caption. Fragments are illustrations for the mockup.
 */
import Icon from "../Icon.astro";
import Mark from "../Mark.astro";
import FileIcon from "../FileIcon.astro";
import Status from "../Status.astro";
---

<section class="section" aria-labelledby="features-title">
  <div class="measure">
    <div class="section-head">
      <h2 id="features-title" class="t-title">Works the way Finder works.</h2>
      <p>Right-click, drag and drop, and the menu bar do what you'd expect. Nothing new to learn.</p>
    </div>
  </div>

  <ul class="features wide">
    <!-- Drop on the menu bar -->
    <li class="feature">
      <div class="feature__art" aria-hidden="true">
        <div class="frag frag--drop">
          <div class="drop__bar">
            <span class="drop__icon"><Mark height={12} label="" /></span>
          </div>
          <div class="drop__panel">
            <p class="frag__title">Drop to upload to Home Server</p>
            <div class="drop__tiles">
              <span><FileIcon kind="folder" size={22} />Photos 2026</span>
              <span class="is-target"><FileIcon kind="folder" size={22} />Invoices</span>
              <span><Icon name="plus" size={20} />Choose folder</span>
            </div>
          </div>
        </div>
      </div>
      <h3 class="t-label">Drop files on the menu bar</h3>
      <p class="t-small muted">Pick a folder on your storage and they upload there.</p>
    </li>

    <!-- Keep on this Mac -->
    <li class="feature">
      <div class="feature__art" aria-hidden="true">
        <div class="frag frag--menu">
          <span>Open</span>
          <span>Get Info</span>
          <hr />
          <span class="is-hover"><Icon name="pinned" size={14} />Keep on this Mac</span>
          <span><Icon name="cloud" size={14} />Remove Download</span>
        </div>
      </div>
      <h3 class="t-label">Keep folders on this Mac</h3>
      <p class="t-small muted">Right-click to keep a folder offline, or remove the download to free the space.</p>
    </li>

    <!-- Verified uploads -->
    <li class="feature">
      <div class="feature__art" aria-hidden="true">
        <div class="frag frag--verify">
          <div class="frag__row">
            <FileIcon kind="document" size={18} />
            <span class="frag__name">Lease agreement.pdf</span>
          </div>
          <Status state="verified" />
          <dl class="verify__sums">
            <div><dt>This Mac</dt><dd>9f2c 41ab 70d3 … e07d</dd></div>
            <div><dt>Your storage</dt><dd>9f2c 41ab 70d3 … e07d</dd></div>
          </dl>
        </div>
      </div>
      <h3 class="t-label">Checked with SHA-256</h3>
      <p class="t-small muted">An upload counts as verified only when the copy on your storage has the same checksum as this Mac.</p>
    </li>

    <!-- Conflicts -->
    <li class="feature">
      <div class="feature__art" aria-hidden="true">
        <div class="frag frag--list">
          <div class="frag__row">
            <FileIcon kind="document" size={18} />
            <span class="frag__name">Notes.md</span>
            <Status state="conflict" words="Both kept" />
          </div>
          <div class="frag__row">
            <FileIcon kind="document" size={18} />
            <span class="frag__name">Notes (conflict copy).md</span>
            <Status state="conflict" words="Both kept" />
          </div>
        </div>
      </div>
      <h3 class="t-label">Nothing is overwritten</h3>
      <p class="t-small muted">When two Macs change one file, you get both copies, side by side.</p>
    </li>

    <!-- Resumable queue -->
    <li class="feature">
      <div class="feature__art" aria-hidden="true">
        <div class="frag frag--list">
          <div class="frag__row">
            <FileIcon kind="movie" size={18} />
            <span class="frag__name">Kitchen renovation.mov</span>
            <span class="frag__btn"><Icon name="pause" size={12} /></span>
          </div>
          <div class="frag__progress"><span style="width:42%"></span></div>
          <div class="frag__row frag__row--quiet">
            <FileIcon kind="archive" size={18} />
            <span class="frag__name">Studio backup.zip</span>
            <span class="frag__meta">Waiting</span>
          </div>
        </div>
      </div>
      <h3 class="t-label">Uploads pick up where they stopped</h3>
      <p class="t-small muted">The queue survives a restart, and resumed uploads are checked before they continue.</p>
    </li>

    <!-- Recently deleted -->
    <li class="feature">
      <div class="feature__art" aria-hidden="true">
        <div class="frag frag--list">
          <p class="frag__title">Recently deleted</p>
          <div class="frag__row">
            <FileIcon kind="folder" size={18} />
            <span class="frag__name">Old invoices</span>
            <span class="frag__pill"><Icon name="restore" size={12} />Restore</span>
          </div>
          <div class="frag__row frag__row--quiet">
            <FileIcon kind="document" size={18} />
            <span class="frag__name">Draft.pages</span>
            <span class="frag__pill"><Icon name="restore" size={12} />Restore</span>
          </div>
        </div>
      </div>
      <h3 class="t-label">Undo a delete</h3>
      <p class="t-small muted">
        On supported storage, deleted items go to a trash on your storage and come back to where they were.
      </p>
    </li>
  </ul>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl) var(--space-xl);
  }

  .feature {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .feature__art {
    display: grid;
    place-items: center;
    height: 236px;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, color-mix(in srgb, var(--mist) 60%, var(--line)), var(--mist));
    box-shadow: inset 0 0 0 0.5px var(--fill-2);
  }

  /* ----- Fragments: small pieces of real UI, drawn in system type ----- */

  .frag {
    font-family: var(--font-system);
    font-size: 13px;
    line-height: 17px;
    color: var(--ink);
    background: var(--paper);
    box-shadow: var(--shadow-canvas);
  }

  .frag__title {
    font-size: 11px;
    line-height: 14px;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .frag__row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .frag__row--quiet {
    color: var(--ink-muted);
  }
  .frag__row--quiet :global(.fi) {
    opacity: 0.72;
  }

  .frag__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .frag__meta {
    font-size: 12px;
    color: var(--ink-muted);
  }

  .frag__btn {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--fill-1);
  }

  .frag__pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 22px;
    padding: 0 9px;
    border-radius: var(--radius-capsule);
    background: var(--fill-1);
    font-size: 11px;
    font-weight: 500;
  }

  .frag__progress {
    height: 3px;
    margin: -2px 0 2px 26px;
    border-radius: 2px;
    background: var(--fill-2);
    overflow: hidden;
  }
  .frag__progress span {
    display: block;
    height: 100%;
    background: var(--ink);
  }

  .frag--list,
  .frag--verify {
    display: grid;
    gap: 12px;
    width: min(82%, 270px);
    padding: 16px;
    border-radius: var(--radius-card);
  }

  /* Drop target */
  .frag--drop {
    width: min(84%, 270px);
    background: none;
    box-shadow: none;
    display: grid;
    justify-items: end;
    gap: 8px;
  }
  .drop__bar {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }
  .drop__icon {
    display: grid;
    place-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: var(--radius-capsule);
    background: var(--ink);
    color: var(--paper);
  }
  .drop__panel {
    width: 100%;
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: 20px;
    background: var(--paper);
    box-shadow: var(--shadow-canvas);
  }
  .drop__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .drop__tiles span {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 12px 2px 10px;
    border-radius: 12px;
    background: var(--fill-1);
    font-size: 11px;
    line-height: 13px;
    text-align: center;
  }
  .drop__tiles span.is-target {
    box-shadow: inset 0 0 0 1.5px var(--ink);
    background: var(--fill-2);
  }

  /* Context menu */
  .frag--menu {
    display: grid;
    width: 200px;
    padding: 5px;
    border-radius: 12px;
  }
  .frag--menu span {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 24px;
    padding: 0 9px 0 28px;
    border-radius: 6px;
  }
  .frag--menu span :global(svg) {
    margin-left: -21px;
    color: var(--ink-muted);
  }
  .frag--menu span.is-hover {
    background: var(--ink);
    color: var(--paper);
  }
  .frag--menu span.is-hover :global(svg) {
    color: var(--paper);
  }
  .frag--menu hr {
    margin: 4px 9px;
    border: 0;
    border-top: 0.5px solid var(--line);
  }

  /* Checksums */
  .verify__sums {
    display: grid;
    gap: 4px;
    padding-top: 10px;
    border-top: 0.5px solid var(--line);
  }
  .verify__sums div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .verify__sums dt {
    font-size: 11px;
    color: var(--ink-muted);
  }
  .verify__sums dd {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 960px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .features {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .feature__art {
      height: 210px;
    }
  }
</style>
