---
import { questions } from "../../data/site";
---

<section id="questions" class="section" aria-labelledby="faq-title">
  <div class="measure">
    <div class="section-head">
      <h2 id="faq-title" class="t-title">Questions</h2>
    </div>

    <div class="faq canvas">
      {
        questions.map(({ q, a }) => (
          <details class="faq__item">
            <summary>
              <span>{q}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M12 5.75v12.5M5.75 12h12.5" />
              </svg>
            </summary>
            <p class="muted">{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 4px 24px;
  }

  .faq__item + .faq__item {
    border-top: 0.5px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: 18px 0;
    font-size: 16px;
    line-height: 22px;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    transition: transform var(--dur) var(--ease);
  }

  .faq details[open] summary svg {
    transform: rotate(45deg);
  }

  .faq__item p {
    max-width: 36em;
    padding: 0 0 20px;
  }

  @media (max-width: 520px) {
    .faq {
      padding-inline: 18px;
    }
  }
</style>
