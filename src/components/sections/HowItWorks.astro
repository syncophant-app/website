---
const steps = [
  {
    title: "Connect your storage",
    body: "Pick SFTP, WebDAV, S3-compatible or SMB and sign in. SFTP takes a password, a private key or your SSH agent.",
    detail: "files.example.com, port 22",
  },
  {
    title: "Check who you're talking to",
    body: "For SFTP, compare the host key with the one your provider shows, then choose Trust this key. If it ever changes, Syncophant stops before it signs in. WebDAV and S3 only connect over HTTPS, and SMB shares must require encryption.",
    detail: "SHA256:7Lx0q2VbT9cJm4…Rk8w",
  },
  {
    title: "Open Finder",
    body: "Your storage is under Locations. Drag files in, or drop them on the menu bar icon.",
  },
];
---

<section id="how-it-works" class="section" aria-labelledby="how-title">
  <div class="measure">
    <div class="section-head">
      <h2 id="how-title" class="t-title">Set it up once.</h2>
      <p>Three steps. Your password or key is saved in your Keychain and nowhere else.</p>
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step__n" aria-hidden="true">
              {i + 1}
            </span>
            <div class="step__text">
              <h3 class="t-subheading">{s.title}</h3>
              <p class="muted">{s.body}</p>
              {s.detail && <code class="t-mono step__detail">{s.detail}</code>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: var(--space-xl);
  }

  .step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-lg);
  }

  .step__n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--fill-3);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .step__text {
    display: grid;
    gap: 6px;
    padding-top: 3px;
  }

  .step__detail {
    justify-self: start;
    margin-top: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-tile);
    background: var(--paper);
    box-shadow: var(--shadow-canvas);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
</style>
