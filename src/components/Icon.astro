---
/**
 * Web stand-in glyphs: 1.5px round-cap lines in currentColor, as the design
 * system asks for when an icon is truly needed on the web. In the app these
 * are SF Symbols.
 */
interface Props {
  name: keyof typeof glyphs;
  size?: number;
  class?: string;
  label?: string;
}

const glyphs = {
  // Finder sidebar
  recents: `<circle cx="12" cy="12" r="8.25"/><path d="M12 7.5V12l3 2"/>`,
  applications: `<path d="M12 3.75 L20 8 L12 12.25 L4 8 Z"/><path d="M4 12l8 4.25L20 12"/><path d="M4 16l8 4.25L20 16"/>`,
  desktop: `<rect x="3.75" y="4.75" width="16.5" height="11.5" rx="2"/><path d="M9 20h6M12 16.25V20"/>`,
  documents: `<path d="M6.75 3.75h6.5l4 4v12.5h-10.5z"/><path d="M13 3.75v4.25h4.25"/>`,
  downloads: `<circle cx="12" cy="12" r="8.25"/><path d="M12 7.5v8M8.75 12.5 12 15.75l3.25-3.25"/>`,
  drive: `<rect x="3.75" y="7.25" width="16.5" height="9.5" rx="2.25"/><path d="M7 13.5h.01M10 13.5h.01"/>`,
  eject: `<path d="M12 6.25 18 13.5H6z"/><path d="M6 17.75h12"/>`,
  // Toolbar
  back: `<path d="M14.5 6.5 9 12l5.5 5.5"/>`,
  forward: `<path d="M9.5 6.5 15 12l-5.5 5.5"/>`,
  list: `<path d="M9 7.25h10.25M9 12h10.25M9 16.75h10.25M4.75 7.25h.01M4.75 12h.01M4.75 16.75h.01"/>`,
  search: `<circle cx="10.75" cy="10.75" r="6"/><path d="m15.25 15.25 4.5 4.5"/>`,
  // File states
  cloud: `<path d="M7.25 18.25h9.5a3.75 3.75 0 0 0 .6-7.45 5.25 5.25 0 0 0-10.2.95A3.25 3.25 0 0 0 7.25 18.25Z"/>`,
  uploading: `<circle cx="12" cy="12" r="8.25"/><path d="M12 16.25v-8M8.75 11.25 12 8l3.25 3.25"/>`,
  verifying: `<path d="M12 3.75a8.25 8.25 0 1 1-8.25 8.25"/><path d="M12 8v4l2.5 1.5"/>`,
  verified: `<path d="M12 3.5l2.1 1.55 2.6-.12.82 2.48 2.1 1.53-.82 2.48.82 2.47-2.1 1.53-.82 2.48-2.6-.12L12 20.5l-2.1-1.55-2.6.12-.82-2.48-2.1-1.53.82-2.47-.82-2.48 2.1-1.53.82-2.48 2.6.12z"/><path d="m8.9 12.1 2.1 2.1 4.1-4.3"/>`,
  unverified: `<path d="M12 4.25 20.25 19H3.75z"/><path d="M12 10v4M12 16.5h.01"/>`,
  conflict: `<rect x="4.25" y="6.75" width="9.5" height="13" rx="1.75"/><path d="M8.25 6.75V5.5c0-.97.78-1.75 1.75-1.75h6c.97 0 1.75.78 1.75 1.75v10.25c0 .97-.78 1.75-1.75 1.75h-2.25"/>`,
  pinned: `<path d="M9.25 3.75h5.5l-.75 5.5 3.25 3.25v1.25H6.75V12.5L10 9.25z"/><path d="M12 13.75v6.5"/>`,
  failed: `<path d="M8.6 3.75h6.8l4.85 4.85v6.8l-4.85 4.85H8.6L3.75 15.4V8.6z"/><path d="m9.5 9.5 5 5M14.5 9.5l-5 5"/>`,
  // Actions
  download: `<path d="M12 4.25v10.5M7.75 10.5 12 14.75l4.25-4.25M5 19.25h14"/>`,
  pause: `<path d="M9.25 7v10M14.75 7v10"/>`,
  restore: `<path d="M4.75 12a7.25 7.25 0 1 0 2.12-5.13"/><path d="M4.75 4.75v3.5h3.5"/>`,
  plus: `<path d="M12 5.75v12.5M5.75 12h12.5"/>`,
  check: `<path d="m5.75 12.5 4 4 8.5-9"/>`,
} as const;

const { name, size = 16, class: className, label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={glyphs[name]}
/>
